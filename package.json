{
  "name": "ETH-Strategy",
  "description": "ETH Strategy core contracts and helpers",
  "license": "GPL-2.0-or-later",
  "version": "1.0.0",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "husky install && forge install",
    "build": "forge build",
    "test": "forge test --fuzz-runs 20",
    "test:integration": "FOUNDRY_PROFILE=integration forge test --fork-url ${FORK_URL:-https://mainnet.gateway.tenderly.co/2ykivsAa1llMFEFYtboaat}",
    "snapshot:espn": "node script/snapshot/espn-holders.mjs",
    "snapshot:selftest": "node script/snapshot/espn-holders.mjs --selftest",
    "verify:redemption": "forge script script/deployments/1/003-espn-redemption/Verify.s.sol --fork-url ${FORK_URL:-https://mainnet.gateway.tenderly.co/2ykivsAa1llMFEFYtboaat} ${SNAPSHOT_BLOCK:+--fork-block-number $SNAPSHOT_BLOCK} -vvv",
    "verify:migration": "forge script script/deployments/1/004-stry-migration/Verify.s.sol --fork-url ${FORK_URL:-https://mainnet.gateway.tenderly.co/2ykivsAa1llMFEFYtboaat} ${SNAPSHOT_BLOCK:+--fork-block-number $SNAPSHOT_BLOCK} -vvv",
    "lint": "yarn lint:forge",
    "lint:forge": "forge fmt --check",
    "lint:fix": "forge fmt",
    "clean": "forge clean"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@trivago/prettier-plugin-sort-imports": "^4.2.0",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "prettier": "^3.0.2",
    "solidity-coverage": "^0.8.4"
  },
  "lint-staged": {
    "*.sol": "forge fmt",
    "*.json": "yarn prettier",
    "*.yml": "yarn prettier"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ]
  }
}
