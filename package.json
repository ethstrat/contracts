{
  "name": "ETH-Strategy",
  "description": "ETH Strategy core contracts and helpers",
  "license": "GPL-2.0-only",
  "version": "1.0.0",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "husky install && forge install",
    "build": "forge build",
    "test": "forge test --fuzz-runs 20",
    "test:integration": "sh -c 'test -n \"$FORK_URL\" || (echo \"❌ FORK_URL is required for integration tests\" && exit 1)' && FOUNDRY_PROFILE=integration forge test --fork-url $FORK_URL",
    "lint": "yarn lint:forge",
    "lint:forge": "forge fmt --check",
    "lint:fix": "forge fmt",
    "clean": "forge clean"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@trivago/prettier-plugin-sort-imports": "^4.2.0",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "prettier": "^3.0.2",
    "solidity-coverage": "^0.8.4"
  },
  "lint-staged": {
    "*.sol": "forge fmt",
    "*.json": "yarn prettier",
    "*.yml": "yarn prettier"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ]
  }
}
