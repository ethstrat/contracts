{
  "name": "ETH-Strategy",
  "description": "ETH Strategy core contracts and helpers",
  "license": "GPL-2.0-or-later",
  "version": "1.0.0",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "husky install && forge install",
    "build": "forge build",
    "test": "forge test --fuzz-runs 20",
    "test:integration": "FOUNDRY_PROFILE=integration forge test --fork-url ${FORK_URL:-https://mainnet.gateway.tenderly.co/2ykivsAa1llMFEFYtboaat}",
    "lint": "yarn lint:forge",
    "lint:forge": "forge fmt --check",
    "lint:fix": "forge fmt",
    "clean": "forge clean",
    "safe:propose": "node --env-file=.env script/safe/propose-batch.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@safe-global/api-kit": "^5.0.2",
    "@safe-global/protocol-kit": "^8.0.6",
    "@trivago/prettier-plugin-sort-imports": "^4.2.0",
    "ethers": "^6.17.0",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "prettier": "^3.0.2",
    "solidity-coverage": "^0.8.4"
  },
  "lint-staged": {
    "*.sol": "forge fmt",
    "*.json": "yarn prettier",
    "*.yml": "yarn prettier"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ]
  }
}
