# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Used by script/safe/propose-batch.mjs (yarn safe:propose <batch.json>).

RPC_URL=
SAFE_API_KEY=

# Pick ONE signer method, not both:
SAFE_PROPOSER_PRIVATE_KEY=
# or (password is never stored — cast prompts for it interactively when the script runs)
SAFE_PROPOSER_KEYSTORE_PATH=
SAFE_PROPOSER_ADDRESS=
